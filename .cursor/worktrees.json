{
  "setup-worktree-unix": [
    "git submodule update --init --recursive",
    "[ -f \"$ROOT_WORKTREE_PATH/config.env\" ] && cp \"$ROOT_WORKTREE_PATH/config.env\" config.env || true"
  ],
  "setup-worktree-windows": [
    "git submodule update --init --recursive",
    "if exist \"%ROOT_WORKTREE_PATH%\\config.env\" copy /Y \"%ROOT_WORKTREE_PATH%\\config.env\" config.env"
  ],
  "setup-worktree": [
    "git submodule update --init --recursive",
    "[ -f \"$ROOT_WORKTREE_PATH/config.env\" ] && cp \"$ROOT_WORKTREE_PATH/config.env\" config.env || true"
  ]
}
